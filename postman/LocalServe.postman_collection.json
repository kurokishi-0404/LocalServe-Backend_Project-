    {
      "name": "2. Services",
      "item": [
        {
          "name": "Create Service (Provider Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "    pm.environment.set('serviceId', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Home Electrical Wiring & Repairs\",\n  \"description\": \"Comprehensive electrical inspection, wiring, short circuit fixes, and appliance installation.\",\n  \"category\": \"Electrical\",\n  \"price\": 499,\n  \"availability\": \"Mon-Sat 9AM-8PM\",\n  \"location\": \"Andheri East, Mumbai\",\n  \"latitude\": 19.1136,\n  \"longitude\": 72.8697\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/services", "host": ["{{baseUrl}}"], "path": ["api", "services"] }
          }
        },
        {
          "name": "Get All Services (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/services?category=Electrical", "host": ["{{baseUrl}}"], "path": ["api", "services"], "query": [{ "key": "category", "value": "Electrical" }] }
          }
        },
        {
          "name": "Get Service by ID (Public)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "services", "{{serviceId}}"] }
          }
        },
        {
          "name": "Update Service (Owner Provider / Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 550,\n  \"availability\": \"Mon-Sun 8AM-9PM\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "services", "{{serviceId}}"] }
          }
        },
        {
          "name": "Delete Service (Owner Provider / Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{providerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/services/{{serviceId}}", "host": ["{{baseUrl}}"], "path": ["api", "services", "{{serviceId}}"] }
          }
        }
      ]
